# Development image for the Base44 sandbox.
#
# Only runtime dependencies are installed here. The repository is bind-mounted
# over /app at run time (see docker-compose.base44.yml), so edits to the source
# take effect without rebuilding this image.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src ./src

RUN pip install --upgrade pip && pip install -e .

EXPOSE 8000
